# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# ID чата, в котором бот обязан работать (узнать можно через @userinfobot / @getmyid_bot)
ALLOWED_CHAT_ID=-1001234567890

# юзернейм бота без @, используется в тексте "верни меня в ..."
BOT_USERNAME=my_rp_bot

# ссылка на тг-канал бота, используется в /links
BOT_CHANNEL_URL=https://t.me/my_rp_channel

# путь к файлу базы данных sqlite (общий для бота и админ-панели!)
DB_PATH=./data/bot.db

# --- Админ-панель (FastAPI) ---
# секретный токен для входа в панель (просто подставляется в URL или форму логина)
ADMIN_PANEL_SECRET=change-me-to-a-long-random-string
# через запятую IP, которым разрешено открывать панель. Пусто = не проверять (не рекомендуется в проде)
ADMIN_PANEL_ALLOWED_IPS=
# порт, на котором поднимается панель
ADMIN_PANEL_PORT=8080

# через сколько дней неактивности отношения/брак расторгаются автоматически
RELATIONSHIP_INACTIVITY_DAYS=14
